<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits plain HTTP only to the Android emulator's host-machine alias, so the
  app can reach a locally-running dev backend during testing. Remove this once
  the backend is deployed behind HTTPS for a real release build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
